{
  "name": "pdf-to-jpg-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Convert PDF pages to JPG in a disposable, network-less Docker sandbox (Poppler). Fastify + React, nothing is stored.",
  "license": "MIT",
  "author": "devzoltan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devzoltan/pdf-to-jpg-sandbox.git"
  },
  "homepage": "https://github.com/devzoltan/pdf-to-jpg-sandbox#readme",
  "bugs": {
    "url": "https://github.com/devzoltan/pdf-to-jpg-sandbox/issues"
  },
  "keywords": [
    "pdf",
    "jpg",
    "pdf-to-image",
    "poppler",
    "docker",
    "sandbox",
    "fastify",
    "react",
    "vite",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <27"
  },
  "scripts": {
    "setup": "npm ci && playwright install chromium",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "npm run build && node dist/server/index.js",
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "worker:update": "tsx scripts/update-worker.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "samples": "tsx scripts/make-samples.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "jpeg-js": "^0.4.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
